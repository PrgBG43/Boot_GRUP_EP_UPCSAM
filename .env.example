# ──────────────────────────────────────────────────────────────
# Turnix – Variables de entorno
# Copia este archivo como .env y ajusta los valores
# cp .env.example .env   (Linux/Mac)
# copy .env.example .env (Windows)
# ──────────────────────────────────────────────────────────────

# Base de datos
# Por defecto usa SQLite local (no requiere instalación adicional)
DATABASE_URL=sqlite:///./turnix.db

# PostgreSQL (opcional – descomenta y completa para usar PostgreSQL)
# POSTGRES_USER=turnix
# POSTGRES_PASSWORD=turnix123
# POSTGRES_DB=turnix_db
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Telegram Bot
# Obtén tu token hablando con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Configuración del negocio por defecto
DEFAULT_BUSINESS_NAME=Turnix Demo Barbería

# Servidor backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173
