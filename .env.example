# Turnix - Variables de entorno
# Copia este archivo como .env y ajusta los valores.

# Base de datos
DATABASE_URL=sqlite:///./turnix.db

# PostgreSQL opcional
# POSTGRES_USER=turnix
# POSTGRES_PASSWORD=turnix123
# POSTGRES_DB=turnix_db
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# JWT / Seguridad
# Cambia este valor en producción.
SECRET_KEY=changeme-turnix-secret-key-2026-demo
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Superadmin inicial creado por python -m app.database.seed
TURNIX_SUPERADMIN_EMAIL=admin@turnix.local
TURNIX_SUPERADMIN_PASSWORD=Admin123*
TURNIX_SUPERADMIN_FIRST_NAME=Administrador
TURNIX_SUPERADMIN_LAST_NAME=Turnix

# Datos demo de desarrollo. En false solo crea datos base y superadmin.
TURNIX_DEMO_SEED=false

# Telegram Bot global
# Obtén el token con @BotFather. No lo subas al repositorio.
TELEGRAM_BOT_TOKEN=
# Username público del bot sin @. Se usa para mostrar https://t.me/<bot>?start=<slug>
TELEGRAM_BOT_USERNAME=

# URL del frontend para CORS
FRONTEND_URL=http://localhost:5173

# Servidor backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
